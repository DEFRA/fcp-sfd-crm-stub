NODE_ENV=local

# Service
SERVICE_VERSION=local
HOST=0.0.0.0
PORT=3001
ENVIRONMENT=local
LOG_ENABLED=true
LOG_LEVEL=info
LOG_FORMAT=pino-pretty

# Request history
REQUEST_HISTORY_MAX_SIZE=1000
REQUEST_HISTORY_WINDOW_MINUTES=10

# Entity store retention (each limit applies to each entity set separately)
# INCIDENT_STORE_MAX_SIZE must be 1 or more; the service refuses to start on 0
INCIDENT_STORE_MAX_SIZE=1000
INCIDENT_STORE_MAX_AGE_MINUTES=0

# dev dependent env vars
SONAR_TOKEN=your-personal-sonar-token # mandatory to enable SonarQube Cloud local scanning
